{
  "name": "nahthatsai",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --filter @nahthatsai/web dev",
    "build": "bun --filter @nahthatsai/web build",
    "start": "bun --filter @nahthatsai/web start",
    "lint": "bun --filter @nahthatsai/web lint",
    "migrate": "bun --filter @nahthatsai/db migrate",
    "seed:tags": "bun --filter @nahthatsai/db seed:tags",
    "seed:demo": "bun --filter @nahthatsai/db seed:demo",
    "seed:unsplash": "bun --filter @nahthatsai/worker seed:unsplash",
    "seed:ai-variants": "bun --filter @nahthatsai/worker seed:ai-variants",
    "recalc:leaderboards": "bun --filter @nahthatsai/worker recalc:leaderboards",
    "seed:pool": "bun --filter @nahthatsai/worker seed:pool",
    "draw:prizes": "bun --filter @nahthatsai/worker draw:prizes",
    "gen:tips": "bun --filter @nahthatsai/worker gen:tips",
    "test": "bun --filter @nahthatsai/web test",
    "typecheck": "bun --filter @nahthatsai/web typecheck"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "trustedDependencies": [
    "sharp",
    "esbuild",
    "@node-rs/argon2"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
